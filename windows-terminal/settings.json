{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": [],
    "alwaysShowTabs": false,
    "launchMode": "maximizedFocus",
    "copyFormatting": "none",
    "copyOnSelect": false,
    "defaultProfile": "{7d1f6a3e-4b2c-4e8a-9f10-3c5d2e8b4a01}",
    "keybindings":
    [
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+c"
        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+v"
        },
        {
            "id": "Terminal.ToggleFocusMode",
            "keys": "ctrl+shift+b"
        },
        {
            "id": "Terminal.CloseWindow",
            "keys": "ctrl+q"
        },
        {
            "id": "Terminal.DuplicatePaneAuto",
            "keys": "alt+shift+d"
        }
    ],
    "newTabMenu":
